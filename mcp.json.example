{
  "//": "Copy this to .mcp.json at your project root and Claude Code will load the server.",
  "//_1": "Deliberately NOT committed as .mcp.json — that would register this server",
  "//_2": "for everyone who opens the repository, whether they want it or not.",
  "//_3": "DATACORE_API_KEY is a secret. Do not commit a file with a real key in it;",
  "//_4": "if your client supports it, read the key from a secret manager instead.",
  "//_5": "The server exchanges the key for short-lived mandates and refreshes them",
  "//_6": "itself, so the key does not expire hourly and you never edit this file",
  "//_7": "because a token ran out. DATACORE_MANDATE still works in its place, but it",
  "//_8": "is a hand-issued mandate: when it expires you replace it and restart.",
  "mcpServers": {
    "datacore-a2a": {
      "command": "datacore-mcp",
      "env": {
        "DATACORE_A2A_URL": "https://gateway.datacore.vn",
        "DATACORE_API_KEY": "dck_<prefix>_<secret>",
        "DATACORE_TIMEOUT": "30"
      }
    }
  }
}
